{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YtGrab",
  "version": "1.1.0",
  "identifier": "com.brunorwanda.ytgrab",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3119",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "YtGrab",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
